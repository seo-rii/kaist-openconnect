def platform_user_agent():
    if sys.platform == "win32":
        platform = "Windows NT 10.0; Win64; x64"
    elif sys.platform == "darwin":
        platform = "Macintosh; Intel Mac OS X 10_15_7"
    else:
        platform = "X11; Linux x86_64"
    return ("Mozilla/5.0 (%s) AppleWebKit/537.36 "
            "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36") % platform


UA = platform_user_agent()


class KvpnError(Exception):
    """A user-facing failure with a clear message."""


# --------------------------------------------------------------------------
# opt-in diagnostics (no request bodies, cookie values, or response text)
# --------------------------------------------------------------------------
def debug_log(event, **fields):
    destination = os.environ.get("KVPN_DEBUG_LOG")
    if not os.environ.get("KVPN_DEBUG") and not destination:
        return
    record = {"time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
              "event": event, **fields}
    line = "[kvpn-debug] " + json.dumps(record, ensure_ascii=True)
    if destination:
        try:
            fd = os.open(os.path.expanduser(destination),
                         os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as stream:
                if hasattr(os, "fchmod"):
                    os.fchmod(stream.fileno(), 0o600)
                stream.write(line + "\n")
        except OSError as exc:
            raise KvpnError("Could not write KVPN_DEBUG_LOG (%s). Choose a writable "
                            "file in an existing directory." % type(exc).__name__) from None
    if os.environ.get("KVPN_DEBUG"):
        print(line, file=sys.stderr, flush=True)


def _debug_url(url):
    """Keep the route for diagnosis, but remove authentication URL material."""
    try:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname or ""
        if parts.port:
            host += ":%s" % parts.port
        path = re.sub(r";[^/]*", ";[redacted]", parts.path)
        path = re.sub(r"/url_[^/]+", "/url_[redacted]", path)
        path = re.sub(r"(/vpn/)[^/]+", r"\1[redacted]", path)
        return urllib.parse.urlunsplit((parts.scheme, host, path, "", ""))
    except (TypeError, ValueError):
        return "[invalid URL]"


def _debug_body(body):
    """Describe unexpected payloads without logging credentials or server text."""
    summary = {"length": len(body)}
    if not body.strip():
        return {**summary, "kind": "empty"}
    # Bound both parser work and the resulting diagnostic record.
    sample = body[:131072]
    try:
        payload = json.loads(sample)
    except (ValueError, RecursionError):
        summary["kind"] = "html" if sample.lstrip().startswith("<") else "text"
        signals = {
            "invalid-access": "invalidaccess.js",
            "session-timeout": "timeout.js",
            "error-page": "error page",
            "bad-request": "bad request",
            "access-denied": "access denied",
            "forbidden": "forbidden",
            "login-form": "login.cgi",
            "otp-menu": "mainmenu.js",
            "javascript-redirect": "location.href",
        }
        lowered = sample.lower()
        summary["signals"] = [name for name, marker in signals.items() if marker in lowered]
        return summary

    remaining = 40

    def shape(value, depth=0):
        nonlocal remaining
        remaining -= 1
        if remaining < 0 or depth > 3:
            return {"type": "omitted"}
        if isinstance(value, dict):
            fields = {}
            for key, child in list(value.items())[:20]:
                if remaining <= 0:
                    break
                # API field names are useful; arbitrary keys may contain user data.
                label = key if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,47}", key) else "[redacted key]"
                fields[label] = shape(child, depth + 1)
            return {"type": "object", "fields": fields, "field_count": len(value)}
        if isinstance(value, list):
            return {"type": "array", "length": len(value),
                    "items": [shape(child, depth + 1) for child in value[:3]]}
        if isinstance(value, str):
            result = {"type": "string", "length": len(value)}
            if value in ("true", "false"):
                result["boolean_text"] = value
            elif depth < 3 and value.lstrip().startswith(("{", "[")):
                try:
                    result["embedded_json"] = shape(json.loads(value), depth + 1)
                except (ValueError, RecursionError):
                    pass
            return result
        if value is None:
            return {"type": "null"}
        if isinstance(value, bool):
            return {"type": "boolean", "value": value}
        return {"type": "number"}

    return {**summary, "kind": "json", "shape": shape(payload)}


class _IvantiDiagnosticParser(HTMLParser):
    """Inspect form structure and error regions, never expose arbitrary text."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.login_form = False
        self.in_login = False
        self.fields = set()
        self.other_field_count = 0
        self.error_tag = None
        self.error_depth = 0
        self.error_text = []
        self.error_regions = []
        self.ignored_tag = None

    def handle_starttag(self, tag, attrs):
        attrs = {name: value or "" for name, value in attrs}
        if tag in ("script", "style"):
            self.ignored_tag = tag
            return
        if self.ignored_tag:
            return
        if tag == "form":
            self.in_login = attrs.get("name", "").lower() == "frmlogin"
            self.login_form = self.login_form or self.in_login
        if self.in_login and tag in ("input", "select", "textarea"):
            name = attrs.get("name")
            if name and "disabled" not in attrs:
                if name in ("username", "password", "realm", "tz_offset", "password#2"):
                    self.fields.add(name)
                else:
                    self.other_field_count += 1
        if self.error_tag:
            if tag == self.error_tag:
                self.error_depth += 1
            return
        style = re.sub(r"\s+", "", attrs.get("style", "")).lower()
        classes = attrs.get("class", "").lower().split()
        if (tag in ("p", "div", "span", "td") and (
                re.search(r"(?:^|;)color:#ff0000(?:;|$)", style)
                or attrs.get("role", "").lower() == "alert"
                or set(classes).intersection(("csserror", "error-message")))):
            self.error_tag = tag
            self.error_depth = 1
            self.error_text = []

    def handle_endtag(self, tag):
        if self.ignored_tag:
            if tag == self.ignored_tag:
                self.ignored_tag = None
            return
        if tag == "form":
            self.in_login = False
        if tag == self.error_tag:
            self.error_depth -= 1
            if not self.error_depth:
                self.error_regions.append(" ".join(self.error_text))
                self.error_tag = None

    def handle_data(self, data):
        if self.error_tag and not self.ignored_tag:
            self.error_text.append(data)


def _ivanti_response_summary(body):
    """Return only fixed labels and counts for the gateway's login response."""
    parser = _IvantiDiagnosticParser()
    parser.feed(body[:131072])
    parser.close()
    regions = parser.error_regions
    if parser.error_tag:
        regions = regions + [" ".join(parser.error_text)]
    errors = []
    lengths = []
    for region in regions[:8]:
        text = " ".join(region.lower().split())
        if not text:
            continue
        lengths.append(len(text))
        labels = {
            "invalid-credentials": ("invalid username or password",),
            "invalid-request": ("invalid request",),
            "login-failed": ("sign-in failed", "login failed"),
            "access-denied": ("access denied",),
            "account-locked": ("account is locked", "account locked"),
            "session-expired": ("session has expired", "session expired"),
        }
        matched = [label for label, markers in labels.items()
                   if any(marker in text for marker in markers)]
        errors.extend(matched or ["unknown-error"])
    return {"login_form": parser.login_form, "fields": sorted(parser.fields),
            "other_field_count": parser.other_field_count,
            "errors": sorted(set(errors)), "error_text_lengths": lengths}


def debug_response(stage, method, request_url, response_url, status, headers, body):
    if not os.environ.get("KVPN_DEBUG") and not os.environ.get("KVPN_DEBUG_LOG"):
        return
    debug_log("http", stage=stage, method=method, url=_debug_url(request_url),
              final_url=_debug_url(response_url), status=status,
              content_type=headers.get("Content-Type", "").split(";", 1)[0][:80],
              content_encoding=headers.get("Content-Encoding", "")[:40],
              location=_debug_url(headers.get("Location", "")),
              body=_debug_body(body))


# --------------------------------------------------------------------------
# HTTP plumbing
# --------------------------------------------------------------------------
def new_session():
    """Return (opener, cookiejar) with its own cookie store."""
    cj = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(
        urllib.request.HTTPCookieProcessor(cj),
        urllib.request.HTTPSHandler(context=ssl.create_default_context()),
    )
    opener.addheaders = [("User-Agent", UA)]
    return opener, cj


def http_get(opener, url, referer=None):
    req = urllib.request.Request(url)
    if referer:
        req.add_header("Referer", referer)
    with opener.open(req, timeout=30) as r:
        body = r.read().decode("utf-8", "replace")
        debug_response("get", "GET", url, r.geturl(), r.getcode(), r.headers, body)
        return r.geturl(), body


def http_post(opener, url, data, referer=None, headers=None):
    body = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=body)
    req.add_header("Content-Type", "application/x-www-form-urlencoded")
    if referer:
        req.add_header("Referer", referer)
    for name, value in (headers or {}).items():
        req.add_header(name, value)
    with opener.open(req, timeout=30) as r:
        body = r.read().decode("utf-8", "replace")
        debug_response("post", "POST", url, r.geturl(), r.getcode(), r.headers, body)
        return r.geturl(), body


def cookie_value(cj, name):
    for c in cj:
        if c.name == name:
            return c.value
    return None


class _NoAutoRedirect(urllib.request.HTTPErrorProcessor):
    """Return 3xx/4xx responses instead of raising or auto-following them,
    so a redirect chain can be walked by hand (cookies still update)."""
    def http_response(self, request, response):
        return response
    https_response = http_response


# --------------------------------------------------------------------------
# Ivanti side
# --------------------------------------------------------------------------
class Ivanti:
    def __init__(self):
        self.opener, self.cj = new_session()
        self.welcome_url = None
        self.login_url = None

    def begin(self):
        """Step 1: land on the sign-in page, capture the login endpoint."""
        url, html = http_get(self.opener, IVANTI + "/")
        self.welcome_url = url
        m = re.search(r'action="([^"]*login\.cgi)"', html)
        if not m:
            m = re.search(r'(/dana-na/auth/url_[^/"\']+/login\.cgi)', html)
        if not m:
            raise KvpnError("Could not find the Ivanti login form. Is the gateway reachable?")
        self.login_url = urllib.parse.urljoin(url, m.group(1))
        return self.welcome_url

    def finish(self, username, password, realm, password2):
        """Step 7: submit primary + secondary credentials, return the DSID."""
        final_url, body = self._submit_login(username, password, realm, password2)
        if "p=failed" in final_url or "p=locked" in final_url:
            raise KvpnError("Ivanti rejected the final login (bad password, or the "
                            "sign-in session expired while entering the code).")
        if "p=user-confirm" in final_url or 'name="frmConfirmation"' in body:
            # Active-session confirmation page: the account already has a live
            # session, and the gateway wants a "Continue" click before issuing
            # a DSID. Submit the confirmation form like the browser would.
            final_url, body = self._confirm_continue(final_url, body)
        dsid = cookie_value(self.cj, "DSID")
        if not dsid:
            raise KvpnError("Login did not yield a DSID cookie (unexpected server response "
                            "at %s)." % final_url)
        return dsid

    def authenticate_primary(self, username, password, realm, handshake):
        """Submit the correlation handshake before asking the portal for OTP."""
        debug_log("primary-auth", phase="submit")
        final_url, body = self._submit_login(username, password, realm, handshake, ajax=True)
        if os.environ.get("KVPN_DEBUG") or os.environ.get("KVPN_DEBUG_LOG"):
            debug_log("primary-auth", phase="submitted",
                      response=_ivanti_response_summary(body),
                      cookies={name: cookie_value(self.cj, name) is not None
                               for name in ("DSSIGNIN", "DSID")})
        if "p=locked" in final_url:
            raise KvpnError("Ivanti reports a locked sign-in. Check the official "
                            "VPN portal before retrying.")
        # The browser's ags_frame.js waits for this POST, but does not require
        # DSID or treat a returned login/challenge page as the final result.
        # onepassCheck determines whether this correlation was authenticated.

    def _submit_login(self, username, password, realm, password2, ajax=False):
        headers = {"Origin": IVANTI}
        if ajax:
            # ags_frame.js uses jQuery $.post for the primary handshake. The
            # final token is submitted by a regular browser form, not AJAX.
            headers.update({"X-Requested-With": "XMLHttpRequest", "Accept": "*/*"})
        return http_post(self.opener, self.login_url, {
            "tz_offset": "540",
            "username": username,
            "password": password,
            "realm": realm,
            "password#2": password2,
        }, referer=self.welcome_url, headers=headers)

    def _confirm_continue(self, page_url, body):
        """Submit the frmConfirmation page (btnContinue + hidden fields)."""
        data = {}
        btn = None
        for tag in re.findall(r"<input\b[^>]*>", body, re.I):
            name = re.search(r'name=["\']([^"\']+)["\']', tag, re.I)
            value = re.search(r'value=["\']([^"\']*)["\']', tag, re.I)
            typ = re.search(r'type=["\']([^"\']+)["\']', tag, re.I)
            if not name:
                continue
            typ = typ.group(1).lower() if typ else "text"
            if typ == "hidden":
                data[name.group(1)] = value.group(1) if value else ""
            elif typ == "submit" and name.group(1).lower() == "btncontinue":
                btn = (name.group(1), value.group(1) if value else "Continue")
        if btn is None:
            btn = ("btnContinue", "Continue the session")
        data[btn[0]] = btn[1]
        debug_log("confirm-session")
        return http_post(self.opener, self.login_url, data, referer=page_url)


# --------------------------------------------------------------------------
# AirCUVE 2Auth portal side
# --------------------------------------------------------------------------
class Portal:
    def __init__(self, parent_url):
        self.opener, self.cj = new_session()
        # second opener over the SAME jar that does not auto-follow redirects
        self.raw = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.cj),
            urllib.request.HTTPSHandler(context=ssl.create_default_context()),
            _NoAutoRedirect,
        )
        self.raw.addheaders = [("User-Agent", UA)]
        self.parent = parent_url

    def _raw(self, method, url, data=None, referer=None, headers=None):
        """Single request, no redirect following. Returns (status, headers, body)."""
        body = urllib.parse.urlencode(data).encode() if data is not None else None
        req = urllib.request.Request(url, data=body, method=method)
        req.add_header("Sec-Fetch-Dest", "iframe")
        req.add_header("Sec-Fetch-Mode", "navigate")
        req.add_header("Sec-Fetch-Site", "same-origin")
        if data is not None:
            req.add_header("Content-Type", "application/x-www-form-urlencoded")
        if referer:
            req.add_header("Referer", referer)
        for name, value in (headers or {}).items():
            req.add_header(name, value)
        with self.raw.open(req, timeout=30) as r:
            body = r.read().decode("utf-8", "replace")
            debug_response("portal", method, url, r.geturl(), r.getcode(), r.headers, body)
            return r.getcode(), r.headers, body

    def begin(self, username):
        """Mint the portal session; return the full primary-auth handshake."""
        rv = PORTAL + "/view/redirectVPN?" + urllib.parse.urlencode({
            "user_name": username,
            "time": int(time.time() * 1000),
            "parent": self.parent,
            "client_id": CLIENT_ID,
            "app_name": APP_NAME,
        })
        page_url, html = http_get(self.opener, rv, referer=self.parent)
        self._check_page("redirectVPN", page_url, html)
        m = re.search(r'name=["\']code["\'][^>]*value=[\'"]([^\'"]+)[\'"]', html)
        if not m:
            raise KvpnError("Portal did not return a correlation code (is the username "
                            "registered for 2Auth?).")
        handshake = m.group(1)
        tag, separator, code = handshake.partition("|")
        if tag != HANDSHAKE_TAG or not separator or not code or "|" in code:
            raise KvpnError("Portal returned an unsupported primary-auth handshake. "
                            "Set KVPN_DEBUG_LOG and check for a kvpn update.")
        self.code = code
        self.redirect_url = rv
        debug_log("portal-init", phase="correlation-received")
        return handshake

    def _check_page(self, stage, url, body):
        """HTTP 200 can still be an initialization failure; never send from it."""
        lowered = body.lower()
        path = urllib.parse.urlsplit(url).path.lower()
        if ("invalidaccess.js" in lowered or "timeout.js" in lowered
                or path.endswith(("/invalidaccess", "/timeout"))):
            debug_log("portal-init", phase="rejected", stage=stage)
            raise KvpnError("Portal initialization failed at %s (invalid access or "
                            "expired session); no code was requested. The portal "
                            "did not confirm primary authentication; this response "
                            "alone does not identify the cause. Compare login in "
                            "the official VPN portal and collect the primary-auth "
                            "diagnostics with KVPN_DEBUG_LOG." % stage)
        if (path.startswith("/view/provision") or re.search(
                r"location\.href\s*=\s*['\"]/view/provision|src=['\"]/js/provision",
                body, re.I)):
            raise KvpnError("The portal requires 2Auth registration. Complete it "
                            "in the official VPN portal; no code was requested.")
        if re.search(r"<title>\s*Error Page\s*</title>", body, re.I):
            raise KvpnError("Portal initialization returned an error page at %s; "
                            "no code was requested. Set KVPN_DEBUG_LOG to collect "
                            "diagnostics." % stage)

    def prepare_otp(self, username):
        """After Ivanti's primary POST, complete the portal's browser handoff."""
        # onepassCheck -> vpnInit: primes the OTP context for this session
        oc = PORTAL + "/view/onepassCheck?" + urllib.parse.urlencode({
            "user_name": username, "code": self.code, "parent": self.parent,
        })
        url, body = http_get(self.opener, oc, referer=self.redirect_url)
        self._check_page("onepassCheck", url, body)
        if (urllib.parse.urlsplit(url).path != "/vpnInit"
                and not re.search(r"location\.href\s*=\s*['\"]/oauth/authorize", body)):
            raise KvpnError("Portal initialization returned an unexpected page at "
                            "onepassCheck; no code was requested. Set KVPN_DEBUG_LOG "
                            "to collect diagnostics.")
        # GET /oauth/authorize (bounces to /request). This registers the OAuth
        # request as Spring Security's "saved request", so after the OTP login
        # the portal redirects back into the OAuth flow instead of to "/".
        authorize = PORTAL + "/oauth/authorize?" + urllib.parse.urlencode({
            "client_id": CLIENT_ID,
            "redirect_uri": PORTAL + "/vpn/" + CLIENT_ID,
            "response_type": "code",
            "scope": "qr",
            "app_name": APP_NAME,
            "user_name": username,
            "parent": self.parent,
        })
        url, body = http_get(self.opener, authorize, referer=url)
        self._check_page("oauth/authorize", url, body)
        # urllib does not execute /request's JavaScript-created POST form.
        # Reproduce only this known handoff, never arbitrary page JavaScript.
        if urllib.parse.urlsplit(url).path == "/request":
            if not re.search(r"\bpost\(\s*['\"]/view/redirect['\"]\s*,", body):
                raise KvpnError("Portal initialization returned an unexpected OAuth "
                                "handoff; no code was requested. Set KVPN_DEBUG_LOG "
                                "to collect diagnostics.")
            url, body = http_post(self.opener, PORTAL + "/view/redirect", {
                "user_name": username,
                "client_id": CLIENT_ID,
                "app_name": APP_NAME,
                # /request embeds a percent-encoded parent in its form value.
                "parent": urllib.parse.quote(self.parent, safe=""),
            }, referer=url)
            self._check_page("view/redirect", url, body)
        if re.search(r"location\.href\s*=\s*['\"]/view/mainMenu['\"]", body):
            url, body = http_get(self.opener, PORTAL + "/view/mainMenu", referer=url)
            self._check_page("mainMenu", url, body)
        if not re.search(r"<script\b[^>]*\bsrc=['\"]/js/mainMenu\.js(?:\?[^'\"]*)?['\"]",
                         body, re.I):
            raise KvpnError("Portal initialization did not reach the OTP menu; "
                            "no code was requested. Set KVPN_DEBUG_LOG to collect "
                            "diagnostics.")
        debug_log("portal-init", phase="otp-ready")

    def send_code(self, username, send_type):
        """Step 4: request a code and require the portal's acknowledgement."""
        if send_type not in OTP_FLAGS:
            raise KvpnError("Unsupported code delivery method: %s" % send_type)
        debug_log("send-code", method=send_type)
        # Match twoAuth_send() in the portal's /js/mainMenu.js. This is a
        # same-origin AJAX call from the portal, not an Ivanti form submission.
        # Do not follow redirects: an expired-session page is not acceptance.
        try:
            status, _, body = self._raw("POST", PORTAL + "/api/portal", data={
                "cmd": "AuthPortal.twoAuthSend",
                "send_type": send_type,
                "user_name": username,
            }, referer=PORTAL + "/view/mainMenu", headers={
                "Accept": "*/*",
                "Origin": PORTAL,
                "X-Requested-With": "XMLHttpRequest",
                "Sec-Fetch-Dest": "empty",
                "Sec-Fetch-Mode": "cors",
            })
        except (urllib.error.URLError, OSError) as exc:
            debug_log("send-code-error", method=send_type, error=type(exc).__name__)
            raise KvpnError("Could not confirm the %s code request (%s). "
                            "Check your connection to the VPN portal before retrying."
                            % (send_type.upper(), type(exc).__name__)) from None
        if status != 200:
            raise KvpnError("The portal did not accept the %s code request "
                            "(HTTP %s). Restart kvpn or check the official VPN portal."
                            % (send_type.upper(), status))
        try:
            result = json.loads(body)
        except ValueError:
            result = None
        if not isinstance(result, dict) or "success" not in result:
            raise KvpnError("The portal returned an unexpected response to the %s "
                            "code request. Delivery is not confirmed; restart kvpn "
                            "or check the official VPN portal. Set KVPN_DEBUG_LOG "
                            "to a file path to collect response diagnostics."
                            % send_type.upper())
        success = result["success"]
        if success is True or success == "true":
            return
        reason = result.get("reason")
        if reason == "emailNull":
            raise KvpnError("The portal reports no registered email address "
                            "[emailNull]. Check this KAIST ID's email in the "
                            "official VPN portal or use SMS.")
        if reason == "phoneNumberNull":
            raise KvpnError("The portal reports no registered phone number "
                            "[phoneNumberNull]. Check this KAIST ID's phone "
                            "number in the official VPN portal or use Email.")
        # Only expose a short symbolic reason, never dump a response containing
        # user data, session cookies, or one-time codes into terminal diagnostics.
        detail = ""
        if isinstance(reason, str) and re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{0,63}", reason):
            detail = " [%s]" % reason
        raise KvpnError("The portal rejected the %s code request%s. "
                        "Check the same account in the official VPN portal."
                        % (send_type.upper(), detail))

    def verify(self, username, otp, send_type="sms"):
        """Steps 5-6: verify the code, walk the OAuth chain by hand, return password#2."""
        if send_type not in OTP_FLAGS:
            raise KvpnError("Unsupported code delivery method: %s" % send_type)
        mainmenu = PORTAL + "/view/mainMenu"

        status, hdrs, _ = self._raw("POST", PORTAL + "/j_spring_security_check.do", {
            "j_username": username,
            "j_password": otp,
            "otp_flag": OTP_FLAGS[send_type],
        }, referer=mainmenu)
        if status not in (301, 302, 303, 307, 308):
            raise KvpnError("Code verification failed (wrong or expired code).")

        # follow the OAuth redirect chain manually to reach the token page
        loc = urllib.parse.urljoin(PORTAL + "/", hdrs.get("Location"))
        body = ""
        for _ in range(6):
            status, hdrs, body = self._raw("GET", loc, referer=mainmenu)
            if status in (301, 302, 303, 307, 308):
                loc = urllib.parse.urljoin(loc, hdrs.get("Location"))
                continue
            break
        if status != 200:
            raise KvpnError("OAuth token page returned HTTP %s at %s" % (status, loc[:120]))

        m = re.search(r'var\s+message\s*=\s*["\']([^"\']+)["\']', body)
        if not m:
            raise KvpnError("Verified OK, but the token (password#2) was not on the OAuth "
                            "page. Re-run with KVPN_DEBUG=1 and share the hop list.")
        return m.group(1)


# --------------------------------------------------------------------------
# credential storage (opt-in)
# --------------------------------------------------------------------------
# The KAIST ID and realm live in a 0600 config file; the password goes into
# the macOS Keychain (service "kvpn") or Windows Credential Manager. On other
# systems the password falls back into the config file itself, still 0600, with
# a warning at save time.
KEYCHAIN_SERVICE = "kvpn"
WINDOWS_CREDENTIAL_TARGET = "kaist-openconnect/kvpn"


def config_path():
    if sys.platform == "win32":
        base = os.environ.get("APPDATA")
        if not base:
            base = os.path.join(os.path.expanduser("~"), "AppData", "Roaming")
        return os.path.join(base, "kvpn", "config.json")
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "kvpn", "config.json")


def keychain_available():
    return sys.platform == "darwin" and shutil.which("security")


def _sec_quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def keychain_set(username, password):
    # `security -i` reads the command from stdin, keeping the password out of
    # the process list.
    line = "add-generic-password -U -a %s -s %s -w %s\n" % (
        _sec_quote(username), _sec_quote(KEYCHAIN_SERVICE), _sec_quote(password))
    r = subprocess.run(["security", "-i"], input=line.encode(),
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if r.returncode != 0:
        raise KvpnError("Could not write to the Keychain: %s"
                        % r.stderr.decode("utf-8", "replace").strip())


def keychain_get(username):
    r = subprocess.run(["security", "find-generic-password",
                        "-a", username, "-s", KEYCHAIN_SERVICE, "-w"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return r.stdout.rstrip("\n")


def keychain_delete(username):
    r = subprocess.run(["security", "delete-generic-password",
                        "-a", username, "-s", KEYCHAIN_SERVICE],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


def _windows_credential_api():
    """Return the native Credential Manager API and its CREDENTIALW type."""
    import ctypes
    from ctypes import wintypes

    class CredentialW(ctypes.Structure):
        _fields_ = [
            ("Flags", wintypes.DWORD),
            ("Type", wintypes.DWORD),
            ("TargetName", wintypes.LPWSTR),
            ("Comment", wintypes.LPWSTR),
            ("LastWritten", wintypes.FILETIME),
            ("CredentialBlobSize", wintypes.DWORD),
            ("CredentialBlob", ctypes.POINTER(ctypes.c_ubyte)),
            ("Persist", wintypes.DWORD),
            ("AttributeCount", wintypes.DWORD),
            ("Attributes", ctypes.c_void_p),
            ("TargetAlias", wintypes.LPWSTR),
            ("UserName", wintypes.LPWSTR),
        ]

    advapi = ctypes.WinDLL("Advapi32.dll", use_last_error=True)
    advapi.CredWriteW.argtypes = [ctypes.POINTER(CredentialW), wintypes.DWORD]
    advapi.CredWriteW.restype = wintypes.BOOL
    advapi.CredReadW.argtypes = [
        wintypes.LPCWSTR,
        wintypes.DWORD,
        wintypes.DWORD,
        ctypes.POINTER(ctypes.POINTER(CredentialW)),
    ]
    advapi.CredReadW.restype = wintypes.BOOL
    advapi.CredDeleteW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD]
    advapi.CredDeleteW.restype = wintypes.BOOL
    advapi.CredFree.argtypes = [ctypes.c_void_p]
    advapi.CredFree.restype = None
    return ctypes, advapi, CredentialW


def windows_credential_set(username, password):
    """Store a password with the current user's Windows Credential Manager."""
    ctypes, advapi, credential_type = _windows_credential_api()
    blob = password.encode("utf-16-le")
    blob_buffer = (ctypes.c_ubyte * len(blob)).from_buffer_copy(blob)
    credential = credential_type()
    credential.Type = 1  # CRED_TYPE_GENERIC
    credential.TargetName = WINDOWS_CREDENTIAL_TARGET
    credential.CredentialBlobSize = len(blob)
    credential.CredentialBlob = ctypes.cast(
        blob_buffer, ctypes.POINTER(ctypes.c_ubyte))
    credential.Persist = 2  # CRED_PERSIST_LOCAL_MACHINE (per-user profile)
    credential.UserName = username
    if not advapi.CredWriteW(ctypes.byref(credential), 0):
        raise KvpnError("Could not write to Windows Credential Manager "
                        "(error %s)." % ctypes.get_last_error())


def windows_credential_get(username):
    """Read this user's password from Windows Credential Manager, if present."""
    ctypes, advapi, credential_type = _windows_credential_api()
    result = ctypes.POINTER(credential_type)()
    if not advapi.CredReadW(WINDOWS_CREDENTIAL_TARGET, 1, 0,
                            ctypes.byref(result)):
        error = ctypes.get_last_error()
        if error == 1168:  # ERROR_NOT_FOUND
            return None
        raise KvpnError("Could not read Windows Credential Manager (error %s)."
                        % error)
    try:
        credential = result.contents
        if credential.UserName != username:
            return None
        blob = ctypes.string_at(credential.CredentialBlob,
                                credential.CredentialBlobSize)
        return blob.decode("utf-16-le")
    finally:
        advapi.CredFree(result)


def windows_credential_delete():
    """Delete the kvpn entry from Windows Credential Manager."""
    ctypes, advapi, _ = _windows_credential_api()
    if advapi.CredDeleteW(WINDOWS_CREDENTIAL_TARGET, 1, 0):
        return True
    error = ctypes.get_last_error()
    if error == 1168:  # ERROR_NOT_FOUND
        return False
    raise KvpnError("Could not delete the Windows Credential Manager entry "
                    "(error %s)." % error)


def _read_config():
    try:
        with open(config_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def _write_config(cfg):
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    if sys.platform != "win32":
        os.chmod(path, 0o600)


def save_credentials(username, password, realm):
    """Persist credentials; returns a human description of where they went."""
    cfg = _read_config()
    cfg.update({"username": username, "realm": realm})
    cfg.pop("password", None)
    where = "config file %s" % config_path()
    if sys.platform == "win32":
        windows_credential_set(username, password)
        where = "Windows Credential Manager (id/realm in %s)" % config_path()
    elif keychain_available():
        keychain_set(username, password)
        where = "macOS Keychain (id/realm in %s)" % config_path()
    else:
        cfg["password"] = password
    _write_config(cfg)
    return where


def load_credentials():
    """Return (username, password, realm) if stored, else None."""
    cfg = _read_config()
    username = cfg.get("username")
    if not username:
        return None
    password = cfg.get("password")
    if password is None:
        if sys.platform == "win32":
            password = windows_credential_get(username)
        elif keychain_available():
            password = keychain_get(username)
    if not password:
        return None
    realm = cfg.get("realm")
    if realm not in REALMS:
        realm = REALMS[0]
    return username, password, realm


def forget_credentials():
    """Remove everything `save_credentials` wrote. Returns True if any existed."""
    removed = False
    username = _read_config().get("username")
    if sys.platform == "win32":
        if windows_credential_delete():
            suffix = " for %s" % username if username else ""
            print("Removed the Windows Credential Manager entry%s." % suffix)
            removed = True
    elif username and keychain_available() and keychain_delete(username):
        print("Removed the Keychain entry for %s." % username)
        removed = True
    try:
        os.remove(config_path())
        print("Removed %s." % config_path())
        removed = True
    except OSError:
        pass
    return removed


def offer_to_save(username, password, realm):
    if sys.platform == "win32":
        dest = "Windows Credential Manager"
    elif keychain_available():
        dest = "the macOS Keychain"
    else:
        dest = config_path()
    try:
        ans = input("Store these credentials in %s for future logins? [y/N]: "
                    % dest).strip().lower()
    except EOFError:
        return
    if ans in ("y", "yes"):
        if sys.platform != "win32" and not keychain_available():
            print("  Note: no Keychain here; the password is stored in a "
                  "user-only (0600) file.")
        where = save_credentials(username, password, realm)
        print("Stored in the %s. Run `kvpn --forget` to remove." % where)


# --------------------------------------------------------------------------
# openconnect
# --------------------------------------------------------------------------
def find_openconnect():
    override = os.environ.get("KVPN_OPENCONNECT")
    if override:
        resolved = shutil.which(override)
        if resolved:
            return resolved
        override = os.path.abspath(os.path.expanduser(override))
        if os.path.isfile(override):
            return override
        raise KvpnError("KVPN_OPENCONNECT does not point to an executable: %s"
                        % override)

    for name in ("openconnect", "openconnect.exe"):
        resolved = shutil.which(name)
        if resolved:
            return resolved

    if sys.platform == "win32":
        roots = [os.environ.get("ProgramW6432"),
                 os.environ.get("ProgramFiles"),
                 os.environ.get("ProgramFiles(x86)")]
        for root in filter(None, roots):
            for directory in ("OpenConnect", "OpenConnect-GUI"):
                candidate = os.path.join(root, directory, "openconnect.exe")
                if os.path.isfile(candidate):
                    return candidate
    return None


def windows_is_admin():
    if sys.platform != "win32":
        return False
    try:
        import ctypes
        return bool(ctypes.windll.shell32.IsUserAnAdmin())
    except (AttributeError, OSError):
        return False


def tunnel_command(openconnect):
    host = IVANTI.split("//", 1)[1]
    args = [openconnect, "--protocol=nc", "--cookie-on-stdin", host]
    if sys.platform == "win32" or (hasattr(os, "geteuid") and os.geteuid() == 0):
        return args
    sudo = shutil.which("sudo")
    if not sudo:
        raise KvpnError("Administrator access is required, but sudo was not found.")
    return [sudo] + args


def launch_tunnel(dsid):
    oc = find_openconnect()
    if not oc:
        raise KvpnError("openconnect not found. Install it or set KVPN_OPENCONNECT to "
                        "the openconnect executable.")
    if sys.platform == "win32" and not windows_is_admin():
        raise KvpnError("Open an Administrator PowerShell or Command Prompt and run "
                        "kvpn again (OpenConnect needs permission to create the tunnel).")
    host = IVANTI.split("//", 1)[1]
    cmd = tunnel_command(oc)
    print("\nBringing up the tunnel%s..." %
          ("" if sys.platform == "win32" else " (sudo may prompt for your password)"))
    if sys.platform == "win32":
        display_command = subprocess.list2cmdline(cmd)
    else:
        import shlex
        display_command = shlex.join(cmd)
    print("  $ %s" % display_command)
    # DSID goes in via stdin so it never appears in the process list.
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)
    try:
        proc.stdin.write(("DSID=%s\n" % dsid).encode())
        proc.stdin.flush()
        proc.stdin.close()
        return proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        return proc.wait()


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------
def choose(prompt, options, default_index=0):
    print(prompt)
    for i, opt in enumerate(options):
        marker = " (default)" if i == default_index else ""
        print("  %d) %s%s" % (i + 1, opt, marker))
    while True:
        raw = input("Choice [%d]: " % (default_index + 1)).strip()
        if not raw:
            return options[default_index]
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print("  Please enter a number between 1 and %d." % len(options))


USAGE = """usage: kvpn [--forget]

  (no options)  connect to the KAIST VPN
  --forget      remove stored credentials (Keychain entry + config file)
  -h, --help    show this help
"""


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(USAGE, end="")
        return
    if "--forget" in argv or "forget" in argv:
        if not forget_credentials():
            print("No stored credentials found.")
        return
    if argv:
        raise KvpnError("Unknown option: %s\n%s" % (" ".join(argv), USAGE))

    debug_log("runtime", platform=sys.platform,
              python=".".join(str(part) for part in sys.version_info[:3]),
              diagnostics_version=3)
    print("=== KAIST VPN (kvpn) ===")
    stored = load_credentials()
    if stored:
        username, password, realm = stored
        print("Using stored credentials for %s (%s). Run `kvpn --forget` to remove."
              % (username, realm))
    else:
        default_user = os.environ.get("KVPN_USER", "")
        username = input("KAIST ID%s: " % (" [%s]" % default_user if default_user else "")).strip() \
            or default_user
        if not username:
            raise KvpnError("A KAIST ID is required.")
        password = getpass.getpass("Password: ")
        if not password:
            raise KvpnError("A password is required.")
        realm = choose("Realm:", REALMS, 0)

    ivanti = Ivanti()
    welcome = ivanti.begin()

    portal = Portal(welcome)
    handshake = portal.begin(username)
    ivanti.authenticate_primary(username, password, realm, handshake)
    portal.prepare_otp(username)

    send_type = "sms" if choose("Send code via:", ["SMS", "Email"], 0) == "SMS" else "email"
    portal.send_code(username, send_type)
    print("Portal accepted the %s code request. It may take up to a minute to arrive."
          % send_type.upper())

    otp = input("Enter the code: ").strip()
    if not otp:
        raise KvpnError("A code is required.")

    password2 = portal.verify(username, otp, send_type=send_type)
    try:
        dsid = ivanti.finish(username, password, realm, password2)
    except KvpnError as e:
        if stored:
            raise KvpnError("%s\nIf your KAIST password changed, run `kvpn --forget` "
                            "and log in again." % e)
        raise
    print("Authenticated. DSID acquired.")

    if not stored:
        offer_to_save(username, password, realm)

    rc = launch_tunnel(dsid)
    sys.exit(rc)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KvpnError as e:
        print("\nError: %s" % e, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        sys.exit(130)
